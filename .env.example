# Local development only. Never commit .env.
POSTGRES_PASSWORD=change-me-local-only
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
LOG_LEVEL=INFO
